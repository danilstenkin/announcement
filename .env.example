# ==================== Application ====================
APP_ENV=development
DEBUG=false
FORCE_REVIEW_TICKETS=false

# ==================== API ====================
API_TITLE=Corporate Announcements API
API_VERSION=1.0.0

# ==================== Database (PostgreSQL) ====================
# Use asyncpg driver
DATABASE_URL=postgresql+asyncpg://pure_rag:CHANGE_ME@postgres:5432/sme_db

# Passwords used by docker-compose postgres service
POSTGRES_USER=pure_rag
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sme_db

# ==================== Events Webhook ====================
EVENTS_WEBHOOK_URL=

# ==================== MinIO ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=announcements
MINIO_SECURE=false

# ==================== File uploads ====================
# MAX_FILE_SIZE is in bytes (default 50 MB)
MAX_FILE_SIZE=52428800
